# Server-seitig (Vercel Serverless Function, api/gemini.js) — NICHT mit VITE_ Prefix, sonst landet er im Client-Bundle
GEMINI_API_KEY=

# Server-seitig (Vercel Serverless Function, api/tts.js) für die Sprachausgabe
# (Google Cloud Text-to-Speech, WaveNet-Stimmen). Einrichtung: Google Cloud
# Console (dasselbe Projekt wie Firebase) > APIs & Dienste > Bibliothek >
# "Cloud Text-to-Speech API" aktivieren (Abrechnungskonto muss hinterlegt
# sein, auch wenn die Nutzung innerhalb des kostenlosen Kontingents bleibt) >
# Anmeldedaten > API-Schlüssel erstellen, auf "Cloud Text-to-Speech API"
# beschränken.
GOOGLE_TTS_API_KEY=

# Server-seitig (api/tts.js) — einzige Google-Konto-E-Mail, für die Vorlesen
# freigeschaltet ist (Kostenschutz). api/tts.js verifiziert das Firebase-ID-Token
# des Nutzers gegen Googles öffentliche Zertifikate und vergleicht email/
# email_verified damit. Fehlt die Variable, lehnt der Endpoint alle Anfragen ab.
ALLOWED_TTS_EMAIL=

# Service-Account-JSON (einzeilig) für firebase-admin in api/gemini.js — aktiviert
# App-Check-Verifizierung + Rate-Limiting für /api/gemini. Ohne diese Variable
# bleibt der Endpoint ungeschützt nutzbar (fail-open), siehe CHANGELOG. Dieselbe
# Variable treibt auch scripts/set-admin-claim.mjs (Admin-Custom-Claim vergeben/
# entziehen, siehe api/gemini.js isAdminRequest).
# Erzeugen: Firebase Console > Projekteinstellungen > Dienstkonten > Neuen
# privaten Schlüssel generieren.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Web-Config (unkritisch, öffentlich vorgesehen — siehe Firestore Security Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA-v3-Site-Key für Firebase App Check (Client). Ohne diese Variable
# bleibt App Check clientseitig aus. Erzeugen: Firebase Console > App Check >
# Web-App registrieren > reCAPTCHA v3.
VITE_RECAPTCHA_SITE_KEY=

# Admin-Bereich (Fehlerreports, siehe src/AdminPanel.jsx). Zugriff läuft über einen
# Firebase Custom Claim ("admin: true", siehe scripts/set-admin-claim.mjs), nicht
# über diese Variable — VITE_ADMIN_EMAIL wird nur noch für den Mailto-Link genutzt.
VITE_ADMIN_EMAIL=

# Automatischer Mail-Versand bei Fehlerreports (siehe api/report-bug.js), egal ob
# der Bug am PC oder am Smartphone auftritt. Server-only, kein VITE_-Prefix.
# API-Key erzeugen: resend.com/api-keys.
RESEND_API_KEY=
# Empfänger der Bug-Mails. Fällt auf VITE_ADMIN_EMAIL zurück, wenn leer.
SUPPORT_EMAIL=
# Absenderadresse. Ohne eigene verifizierte Domain (resend.com/domains) bleibt
# es beim Resend-Sandbox-Absender, der ohne Verifizierung funktioniert.
RESEND_FROM_EMAIL=Sm@rtCraft Bug-Report <onboarding@resend.dev>
